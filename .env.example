# Bridge address Console bound. GET /health on this origin must return 200.
SWITCH_BASE_URL=http://127.0.0.1:8000

# Gateway key of type registration. Do not put the deployment bootstrap key here.
SWITCH_REGISTRATION_KEY=
# Set to bootstrap only to prove the register script refuses it.
SWITCH_KEY_KIND=
SWITCH_BOOTSTRAP_KEY=

# Filled by npm run register into data/agent.json. Optional overrides:
SWITCH_AGENT_ID=
SWITCH_AGENT_KEY=
SWITCH_CONNECTION_ID=
SWITCH_ROOM_ID=
# Mattermost-linked Switch participant id. Approvals fail closed until this is set.
SWITCH_OWNER_PARTICIPANT_ID=
# Optional. Printed by Console's About or the install filename.
SWITCH_CONSOLE_VERSION=

# live is required for npm start. scripted is for npm test only.
LLM_MODE=live
# openai or gemini
LLM_PROVIDER=openai
LLM_API_KEY=
# Blank uses gpt-4o-mini (openai) or gemini-2.5-flash (gemini). Any chat model works,
# including gpt-5 and o-series models; temperature is left out for those automatically.
LLM_MODEL=
LLM_BASE_URL=

# Frozen clock for the 30-day window. The seed orders assume this date.
DEMO_TODAY=2026-11-06
PORT=8787
DATA_PATH=data/refund-desk.sqlite
